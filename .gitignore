# ORB-SLAM3 Atlas save and per-run console captures -- regenerated every
# mission run, not source. Keep the specific log you want as evidence by
# copying it into docs/ instead of relying on it staying in slam_atlas/.
slam_atlas/*.osa
slam_atlas/orb_slam3_console_*.log

