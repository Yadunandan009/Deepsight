build/
install/
log/
logs/
*.bak.*
__pycache__/
*.pyc

# Large regeneratable intermediate/cache data -- not source, not results.
# Regenerate via the corresponding extract/generate script instead of
# committing (task_a_topics.npz alone was 333MB; GitHub has already
# flagged large binaries in this repo before).
plots/task_a_topics.npz
plots/_mosaic_*.npy

# ORB-SLAM3 Atlas save and per-run console captures -- regenerated every
# mission run, not source. Keep the specific log you want as evidence by
# copying it into docs/ instead of relying on it staying in slam_atlas/.
slam_atlas/*.osa
slam_atlas/orb_slam3_console_*.log

# External tool clones checked out for experimentation, not part of this
# project's own source.
external/

# Per-trial evaluation bags -- regenerate via eval/run_trial.py.
eval/bags/

# Figure extraction caches -- regenerate by deleting and re-running the
# fig_*.py script. Derived from the bags, not source.
eval/figures/.*_cache.json

# Task A re-run intermediates: extracted bag topics and bootstrap arrays.
# Regenerate with eval/task_a_reextract.py + task_a_icp.py; the .npz files
# are large and derived, the logs under eval/task_a_out/ are the record.
plots/task_a_topics_*.npz
eval/task_a_out/*.npz
