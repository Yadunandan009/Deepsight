Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
    - Class: rviz_default_plugins/RobotModel
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      Visual Enabled: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Arrows: true
      Show Names: true
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Keep: 100
      Name: EKF_Path
      Topic:
        Value: /bluerov2/odometry/filtered
  Global Options:
    Fixed Frame: odom
    Publish transform: true
  Tools:
    - Class: rviz_default_plugins/MoveCamera
