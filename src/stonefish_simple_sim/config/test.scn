<?xml version="1.0"?>

<scenario>
	<environment>
		<ned latitude="41.0" longitude="-71.0"/>
		<ocean>
			<water density="1023.0" jerlov="0.2"/>
		<!--	 <waves height="1.5"/> -->
		     	<particles enabled="true"/> 
			<current type="uniform">
				<velocity xyz="0.0 0.0 0.0"/>
			</current>
		</ocean>
		<atmosphere>
			<sun azimuth="40.0" elevation="10.0"/>
		</atmosphere>
	</environment>

	<include file="$(find stonefish_simple_sim)/config/materials.scn"/>
	<include file="$(find stonefish_simple_sim)/config/looks.scn"/>

    <robot name="sub" fixed="false" self_collisions="false">
        <base_link name="Vehicle" type="compound" physics="submerged">
            <external_part name="Hull" type="model" physics="submerged" buoyant="false">
                <physical>
                    <mesh filename="/home/yadunandan/ros2_ws/src/stonefish_simple_sim/data/parts/body/hull.obj" scale="0.001"/>
                    <origin rpy="1.5707 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </physical>
                <visual>
                    <mesh filename="/home/yadunandan/ros2_ws/src/stonefish_simple_sim/data/parts/body/hull.obj" scale="0.001"/>
                    <origin rpy="1.5707 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </visual>
                <material name="Vehicle"/>
                <look name="yellow"/>
                <mass value="26.0"/>
                <!-- <inertia xyz="1.0 8.0 8.0"/> -->
                <compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                <cg xyz="-0.65 0.0 0.00" rpy="0.0 0.0 0.0"/>
            </external_part>

            <internal_part name="Foam" type="cylinder" physics="floating" buoyant="true">
                <dimensions radius="0.112" height="0.68"/>
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                <material name="Foam"/>
                <mass value="0.5"/>
                <look name="grey"/>
                <compound_transform rpy="0.0 1.571 0.0" xyz="-0.65 0.0 -0.1"/>
            </internal_part>

            <external_part name="Mast" type="model" physics="submerged" buoyant="true ">
                <physical>
                    <mesh filename="/home/yadunandan/ros2_ws/src/stonefish_simple_sim/data/parts/body/mast.obj" scale="0.001"/>
                    <origin rpy="-1.571 0.0 1.571"  xyz="-1.0 0.0 0.0"/>
                </physical>
                <visual>
                    <mesh filename="/home/yadunandan/ros2_ws/src/stonefish_simple_sim/data/parts/body/mast.obj" scale="0.001"/>
                    <origin rpy="-1.571 0.0 1.571" xyz="-1.0 0.0 0.0"/>
                </visual>
                <material name="Resin"/>
                <look name="red"/>
                <compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
            </external_part>

            <external_part name="ThrusterDuctSurge" type="model" physics="submerged" buoyant="false">
                <physical>
                    <mesh filename="/home/yadunandan/ros2_ws/src/stonefish_simple_sim/data/parts/body/duct.obj" scale="0.0015"/>
                    <origin rpy="0.0 1.571 0.0" xyz="-1.5 0.0 0.0"/>
                </physical>
                <visual>
                    <mesh filename="/home/yadunandan/ros2_ws/src/stonefish_simple_sim/data/parts/body/duct.obj" scale="0.0015"/>
                    <origin rpy="0.0 1.571 0.0" xyz="-1.5 0.0 0.0"/>
                </visual>
                <material name="Neutral"/>
                <look name="black"/>
                <compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
            </external_part>
        </base_link>

        <!-- the actual base frame  -->
        <link name="Base" type="box" physics="submerged">
            <dimensions xyz="0.01 0.02 0.01"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <material name="Neutral"/>
            <look name="Green"/>
        </link>


        <joint name="Joint1" type="fixed">
            <parent name="Vehicle"/>
            <child name="Base"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <axis xyz="1.0 0.0 0.0"/>
        </joint>

        <!--  -->
        <!-- Thruster -->
        <actuator name="ThrusterSurge" type="propeller">
                <link name="Base"/>
                <origin rpy="0.0 0.0 0.0" xyz="-1.5 0.0 0.0"/>
                <specs thrust_coeff="278.0" torque_coeff="0.01" max_rpm="3000.0"/>
                 <!-- <specs thrust_coeff="0.3411" torque_coeff="0.01" max_rpm="3000.0"/> -->
                <propeller diameter="0.1145" right="true">
                    <origin rpy="1.571 0.0 0.0" xyz="0.0 0.0 0.0"/>
                    <mesh filename="/home/yadunandan/ros2_ws/src/stonefish_simple_sim/data/parts/body/prop.obj" scale="1.0"/>
                    <material name="Neutral"/>
                    <look name="red"/>
                </propeller>
            <ros_subscriber topic="sub/thruster/surge"/>
        </actuator>

        <actuator name="ThrusterSwayBow" type="propeller">
            <link name="Base"/>
            <origin rpy="0.0 0.0 -1.5707963" xyz="-0.2295 0.0 0.0"/>
            <specs thrust_coeff="286.7" torque_coeff="0.01" max_rpm="3000.0"/>
            <propeller diameter="0.08" right="true">
                <mesh filename="/home/yadunandan/ros2_ws/src/stonefish_simple_sim/data/parts/body/prop.obj" scale="1.0"/>
                <material name="Neutral"/>
                <look name="white"/>
            </propeller>
            <ros_subscriber topic="sub/thruster/sway_bow"/>
        </actuator>

        <actuator name="ThrusterHeaveStern" type="propeller">
            <link name="Base"/>
            <origin rpy="0.0 1.571 0.0" xyz="-1.13 0.0 0.0"/>
            <specs thrust_coeff="286.7" torque_coeff="0.01" max_rpm="3000.0"/>
            <propeller diameter="0.08" right="true">
                <mesh filename="/home/yadunandan/ros2_ws/src/stonefish_simple_sim/data/parts/body/prop.obj" scale="1.0"/>
                <material name="Neutral"/>
                <look name="white"/>
            </propeller>
            <ros_subscriber topic="sub/thruster/heave_stern"/>
        </actuator>

        <actuator name="ThrusterHeaveBow" type="propeller">
            <link name="Base"/>
            <origin rpy="0.0 1.571 0.0" xyz="-0.3545 0.0 0.0"/>
            <specs thrust_coeff="286.7" torque_coeff="0.01" max_rpm="3000.0"/>
            <propeller diameter="0.08" right="true">
                <mesh filename="/home/yadunandan/ros2_ws/src/stonefish_simple_sim/data/parts/body/prop.obj" scale="1.0"/>
                <material name="Neutral"/>
                <look name="white"/>
            </propeller>
            <ros_subscriber topic="sub/thruster/heave_bow"/>
        </actuator>


        <!-- sensors -->
         <sensor name="imu" type="imu" rate="20.0">
                <link name="Base"/>
                <origin rpy="3.1415926 0.0 0.0" xyz="-0.7 0.0 -0.05"/>
                <!-- <noise angle="0.0001 0.0001 0.0001" angular_velocity="0.0001" yaw_drift="0.0001" linear_acceleration="0.0001"/> -->
                <noise angle="0.0 0.0 0.0" angular_velocity="0.0" yaw_drift="0.0" linear_acceleration="0.000"/>
                <ros_publisher topic="sub/imu/stonefish/data"/>
        </sensor>

        <sensor name="pressure" type="pressure" rate="5.0">
                <link name="Base"/>
                <origin rpy="0.0 0.0 0.0" xyz="-1.0 0.0 0.0"/>
                <noise pressure="2.0"/>
                <ros_publisher topic="sub/pressure"/>
        </sensor>

        <sensor name="bow_camera" rate="10.0" type="camera">
            <specs resolution_x="800" resolution_y="600" horizontal_fov="60.0"/>
            <origin xyz="0.5 0.0 0.0" rpy="1.57 0.0 1.57"/>
            <link name="Base"/>
            <ros_publisher topic="sub/bow/image"/>
        </sensor>

        <sensor name="port" rate="10.0" type="camera">
            <specs resolution_x="800" resolution_y="600" horizontal_fov="60.0"/>
            <origin xyz="-0.5 0.0 0.0" rpy="1.57 0.0 0"/>
            <link name="Base"/>
            <ros_publisher topic="sub/port/image"/>
        </sensor>

        <sensor name="starboard" rate="10.0" type="camera">
            <specs resolution_x="800" resolution_y="600" horizontal_fov="60.0"/>
            <origin xyz="-0.5 0.0 0.0" rpy="1.57 0.0 -3.14"/>
            <link name="Base"/>
            <ros_publisher topic="sub/starboard/image"/>
        </sensor>

        <sensor name="bottom" rate="10.0" type="camera">
            <specs resolution_x="800" resolution_y="600" horizontal_fov="60.0"/>
            <origin xyz="-0.5 0.0 0.0" rpy="0.0 0.0 1.57"/>
            <link name="Base"/>
            <ros_publisher topic="sub/bottom/image"/>
        </sensor>

<comm_interface type="udp_socket">
    <address>127.0.0.1</address>
    <port>9002</port>
    <protocol>json</protocol>
    <sensors>
        <imu name="imu"/>
        <pressure name="pressure"/>
        <gps name="gps"/>
    </sensors>
    <actuators>
        <thruster name="thruster_surge" id="0"/>
        <thruster name="thruster_sway_bow" id="1"/>
        <thruster name="thruster_heave_bow" id="2"/>
        <thruster name="thruster_heave_stern" id="3"/>
    </actuators>
</comm_interface>
        
        <world_transform xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </robot>


<static name="Bottom" type="plane">
    <material name="Rock"/>
    <look name="Gray"/>
    <world_transform xyz="0.0 0.0 40.0" rpy="0.0 0.0 0.0"/>
</static>


</scenario>

