Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 5
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/PointCloud2
      Name: ORB-SLAM3 map points
      Enabled: true
      Topic:
        Value: /bluerov2/map_points
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 5
      Style: Points
      Size (Pixels): 2
      Size (m): 0.05
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0
    - Class: rviz_default_plugins/Pose
      Name: SLAM pose
      Enabled: true
      Topic:
        Value: /bluerov2/robot_pose_slam
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 5
      Shape: Arrow
      Color: 255; 25; 0
      Shaft Length: 2
      Head Length: 0.6
      Shaft Radius: 0.15
      Head Radius: 0.4
  Global Options:
    Fixed Frame: map
    Background Color: 255; 255; 255
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 60
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.5
      Yaw: 0.8
Window Geometry:
  Width: 1400
  Height: 900
